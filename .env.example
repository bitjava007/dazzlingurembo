# Root environment variables
# Copy this file to .env and fill in real values — never commit .env

# Application
NODE_ENV=development
PORT=3001

# ── Database (Supabase) ────────────────────────────────────────────────────────
# DATABASE_URL  : transaction pooler (port 6543) — used by the running app
# DIRECT_URL    : direct connection  (port 5432) — used only by prisma migrate
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<DB-PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres"

# Authentication
JWT_SECRET=replace-with-a-random-64-char-string-in-production
JWT_EXPIRES_IN=7d

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Redis (optional)
# REDIS_URL=redis://localhost:6379
